<group name="windows,sysmon,credential_access,edr_lab,">

  <rule id="101001" level="12">
    <if_group>sysmon_event_10</if_group>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)\\\\lsass\.exe$</field>
    <field name="win.eventdata.sourceImage" type="pcre2" negate="yes">(?i)(C:\\\\Program Files|\\\\(MsMpEng|WmiPrvSE|svchost|csrss|wininit|services|lsass|wazuh-agent|Sysmon64|vmtoolsd)\.exe$)</field>
    <description>LSASS handle opened by $(win.eventdata.sourceImage) (access $(win.eventdata.grantedAccess)), possible credential dumping</description>
    <mitre><id>T1003.001</id></mitre>
  </rule>

  <rule id="101002" level="14">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)comsvcs(\.dll)?[\s,"]+(MiniDump|#\+?24)</field>
    <description>comsvcs.dll MiniDump invoked: $(win.eventdata.commandLine)</description>
    <mitre><id>T1003.001</id></mitre>
  </rule>

  <rule id="101003" level="14">
    <if_group>sysmon_event_11</if_group>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)lsass[^\\\\]*\.dmp$</field>
    <description>LSASS dump file written: $(win.eventdata.targetFilename) by $(win.eventdata.image)</description>
    <mitre><id>T1003.001</id></mitre>
  </rule>

</group>
