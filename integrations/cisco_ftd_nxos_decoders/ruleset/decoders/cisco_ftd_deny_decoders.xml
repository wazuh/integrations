<!--
  -  Cisco FTD access-list deny decoders (message 106023).
  -  Extends the stock Wazuh Cisco FTD decoders to cover:
  -    - the "%FTD-session-" message prefix emitted by some FTD builds,
  -    - interface names containing hyphens or other non-word characters,
  -    - ICMP deny events, which carry no port and instead report type/code.
  -
  -  IMPORTANT - PLACEMENT
  -  Wazuh commits the FIRST child decoder whose <prematch> matches, even when
  -  its <regex> subsequently fails to extract anything. A catch-all child with
  -  no <prematch> therefore shadows every child placed after it. These blocks
  -  must be merged into the stock Cisco FTD decoder file ABOVE any generic
  -  child decoder. See the README for the two supported deployment methods.
  -
  -  This program is free software; you can redistribute it and/or modify it
  -  under the terms of GPLv2.
-->

<!--
  - Parent decoder for the "%FTD-session-" prefix.
  -
  - The stock parent only matches "%FTD-<severity>-<id>". Some FTD builds emit
  - "%FTD-session-<severity>-<id>" instead, which the stock prematch rejects,
  - so those events fall through undecoded and are only visible in archives.
  - This is a new top-level parent rather than an edit to the stock one, so it
  - does not conflict: it only ever sees messages the stock parent declined.
  -
  - Sample:
  -   Jun 15 07:28:42 192.0.2.1  : : %FTD-session-4-106023: Deny tcp src ...
-->
<decoder name="cisco-ftd-session">
  <prematch type="pcre2">%FTD-session-\d-\d+</prematch>
</decoder>

<!--
  - TCP/UDP deny, "%FTD-session-" prefix.
  -
  - Sample:
  -   %FTD-session-4-106023: Deny tcp src LAN-INT:192.0.2.124/65191
  -     dst LAN-EXT:198.51.100.157/80 by access-group "CSM_FW_ACL_" [0x0, 0x0]
  -
  - Interface names are matched with [^:\s]+ rather than \w+ so that names
  - containing hyphens (LAN-INT, LAN-EXT, DMZ-INT) are extracted correctly.
  - Addresses use [^/\s]+ so the port is not swallowed by a greedy match.
-->
<decoder name="cisco-ftd-session-acl-deny">
  <parent>cisco-ftd-session</parent>
  <prematch type="pcre2">%FTD-session-\d-106023: \w+ (?:tcp|udp) src </prematch>
  <regex type="pcre2">%FTD-session-(\d)-(\d+): (\w+) (\w+) src ([^:\s]+):([^/\s]+)/(\d+) dst ([^:\s]+):([^/\s]+)/(\d+) by access-group "([^"]+)"</regex>
  <order>cisco.severity, cisco.message_id, action, protocol, src_interface, srcip, srcport, dst_interface, dstip, dstport, cisco.access_group</order>
</decoder>

<!--
  - ICMP deny, "%FTD-session-" prefix.
  -
  - Sample:
  -   %FTD-session-4-106023: Deny icmp src DMZ-INT:192.0.2.23
  -     dst LAN-EXT:198.51.100.5 (type 8, code 0) by access-group "CSM_FW_ACL_"
  -
  - ICMP events carry no port. The stock port-bearing pattern cannot match them,
  - so they need a dedicated decoder that captures type and code instead.
-->
<decoder name="cisco-ftd-session-acl-deny-icmp">
  <parent>cisco-ftd-session</parent>
  <prematch type="pcre2">%FTD-session-\d-106023: \w+ icmp src </prematch>
  <regex type="pcre2">%FTD-session-(\d)-(\d+): (\w+) (icmp) src ([^:\s]+):(\S+) dst ([^:\s]+):(\S+) \(type (\d+), code (\d+)\) by access-group "([^"]+)"</regex>
  <order>cisco.severity, cisco.message_id, action, protocol, src_interface, srcip, dst_interface, dstip, cisco.icmp_type, cisco.icmp_code, cisco.access_group</order>
</decoder>

<!--
  - TCP/UDP deny, standard "%FTD-" prefix.
  -
  - Sample:
  -   %FTD-4-106023: Deny tcp src LAN-INT:192.0.2.124/65191
  -     dst LAN-EXT:198.51.100.157/80 by access-group "CSM_FW_ACL_" [0x0, 0x0]
  -
  - Attaches to the stock cisco-ftd parent. Must be merged above any generic
  - child of that parent.
-->
<decoder name="cisco-ftd-acl-deny">
  <parent>cisco-ftd</parent>
  <prematch type="pcre2">%FTD-\d-106023: \w+ (?:tcp|udp) src </prematch>
  <regex type="pcre2">%FTD-(\d)-(\d+): (\w+) (\w+) src ([^:\s]+):([^/\s]+)/(\d+) dst ([^:\s]+):([^/\s]+)/(\d+) by access-group "([^"]+)"</regex>
  <order>cisco.severity, cisco.message_id, action, protocol, src_interface, srcip, srcport, dst_interface, dstip, dstport, cisco.access_group</order>
</decoder>

<!--
  - ICMP deny, standard "%FTD-" prefix.
  -
  - Sample:
  -   %FTD-4-106023: Deny icmp src DMZ-INT:192.0.2.23
  -     dst LAN-EXT:198.51.100.5 (type 8, code 0) by access-group "CSM_FW_ACL_"
-->
<decoder name="cisco-ftd-acl-deny-icmp">
  <parent>cisco-ftd</parent>
  <prematch type="pcre2">%FTD-\d-106023: \w+ icmp src </prematch>
  <regex type="pcre2">%FTD-(\d)-(\d+): (\w+) (icmp) src ([^:\s]+):(\S+) dst ([^:\s]+):(\S+) \(type (\d+), code (\d+)\) by access-group "([^"]+)"</regex>
  <order>cisco.severity, cisco.message_id, action, protocol, src_interface, srcip, dst_interface, dstip, cisco.icmp_type, cisco.icmp_code, cisco.access_group</order>
</decoder>
