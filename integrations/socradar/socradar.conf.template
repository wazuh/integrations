{
  "company_id": "YOUR_COMPANY_ID",
  "api_key": "YOUR_SOCRADAR_API_KEY",
  "user_email": "your-email@company.com",

  "_comment_tls": "=== TLS / SSL ===",
  "tls_verify": true,
  "ca_bundle_path": null,

  "_comment_logging": "=== Logging / Debug ===",
  "verbose": false,
  "log_level": "INFO",

  "_comment_fetch": "=== Wodle Fetch Settings (defaults match wodles/socradar.py) ===",
  "fetch_status": "OPEN",
  "fetch_limit": 100,
  "min_severity": null,
  "alarm_main_types": [],
  "initial_lookback_hours": 24,
  "_comment_overlap": "Catch-up interval and window (seconds) — visibility wait, not incremental API cost. Incremental is last_run→now with no per-tick overlap. Every this many seconds the same wodle also fetches now−this→now. Default 180 means a late OPEN alarm waits up to 180s (not the next minute). Raise it if you need a longer recovery window — cost scales linearly with it. 0 disables catch-up.",
  "fetch_overlap_seconds": 180,
  "max_pages": 10,
  "_comment_catchup_budget": "Per-run older-page budget for uncapped windows (catch-up and first-run lookback). Walks the true last page first; leftover pages resume next tick. Incremental still uses max_pages.",
  "max_catchup_pages": 15,
  "http_timeout_seconds": 120,
  "catchup_http_timeout_seconds": 15,
  "http_retries": 0,
  "page_sleep_seconds": 2,
  "lookback_page_sleep_seconds": 2,
  "max_retry_pages": 25,
  "max_retry_pages_per_run": 1,
  "retry_backoff_seconds": 60,
  "retry_backoff_max_seconds": 3600,

  "_comment_integration": "=== Integration (Wazuh → SOCRadar) Settings ===",
  "integration": {
    "auto_tag": true,
    "post_wazuh_context": true,
    "auto_close_rule_ids": [],
