<!-- Synthetic test rules: a reduced Windows event channel chain. -->
<group name="windows,">
  <rule id="60000" level="0">
    <category>ossec</category>
    <decoded_as>windows_eventchannel</decoded_as>
    <field name="win.system.providerName">\.+</field>
    <description>Windows event channel event.</description>
  </rule>

  <rule id="60001" level="0">
    <if_sid>60000</if_sid>
    <field name="win.system.channel">^Security$</field>
    <description>Windows Security channel.</description>
  </rule>

  <rule id="60002" level="0">
    <if_sid>60000</if_sid>
    <field name="win.system.channel">^System$</field>
    <description>Windows System channel.</description>
  </rule>

  <rule id="60004" level="0">
    <if_sid>60000</if_sid>
    <field name="win.system.channel">^Microsoft-Windows-Sysmon/Operational$</field>
    <description>Sysmon channel.</description>
  </rule>

  <rule id="60007" level="0">
    <if_sid>60002</if_sid>
    <field name="win.system.providerName">^Microsoft-Windows-Eventlog$</field>
    <description>Windows event log service.</description>
  </rule>

  <rule id="60010" level="0">
    <if_sid>60000</if_sid>
    <field name="win.system.channel">^Microsoft-Windows-PowerShell/Operational$</field>
    <description>PowerShell channel.</description>
  </rule>

  <rule id="60103" level="0">
    <if_sid>60001</if_sid>
    <field name="win.system.severityValue">^AUDIT_SUCCESS$</field>
    <description>Windows audit success.</description>
  </rule>

  <rule id="60104" level="5">
    <if_sid>60001</if_sid>
    <field name="win.system.severityValue">^AUDIT_FAILURE$</field>
    <description>Windows audit failure.</description>
  </rule>

  <rule id="60106" level="3">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4624$</field>
    <description>Windows logon success.</description>
    <group>authentication_success,</group>
  </rule>

  <rule id="61600" level="0">
    <if_sid>60004</if_sid>
    <field name="win.system.severityValue">^INFORMATION$</field>
    <description>Sysmon information event.</description>
  </rule>

  <rule id="61602" level="5">
    <if_sid>60004</if_sid>
    <field name="win.system.severityValue">^ERROR$</field>
    <description>Sysmon error event.</description>
    <group>system_error,</group>
  </rule>

  <rule id="61603" level="0">
    <if_sid>61600</if_sid>
    <field name="win.system.eventID">^1$</field>
    <description>Sysmon event 1: process creation.</description>
    <group>sysmon_event1,</group>
  </rule>

  <rule id="61613" level="0">
    <if_sid>61600</if_sid>
    <field name="win.system.eventID">^11$</field>
    <description>Sysmon event 11: file created.</description>
    <group>sysmon_event_11,</group>
  </rule>

  <rule id="61615" level="0">
    <if_sid>61600</if_sid>
    <field name="win.system.eventID">^13$</field>
    <description>Sysmon event 13: registry value set.</description>
    <group>sysmon_event_13,</group>
  </rule>

  <rule id="91801" level="0">
    <if_sid>60000, 60010</if_sid>
    <field name="win.system.providerName">^Microsoft-Windows-PowerShell$</field>
    <description>PowerShell event.</description>
  </rule>

  <rule id="91802" level="0">
    <if_sid>91801</if_sid>
    <field name="win.eventdata.ScriptBlockId" type="pcre2">^[0-9a-f-]+$</field>
    <description>PowerShell script block.</description>
  </rule>

  <rule id="92200" level="6">
    <if_group>sysmon_event_11</if_group>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)\\Temp\\.+\.(bat|cmd|ps1)$</field>
    <description>Script file written to a temporary folder.</description>
  </rule>
</group>
