{
  "inserted_at": "2026-09-09T12:08:13.321106Z",
  "name": "742b66ae-15d3-53c2-8735-f791fbea8d81",
  "offset": 400,
  "payload": {
    "document": {
      "check": "exists($_tmp_json.log) AND exists($_tmp_json.stream) AND exists($_tmp_json.time) AND ($_tmp_json.stream == 'stdout' OR $_tmp_json.stream == 'stderr')",
      "enabled": true,
      "id": "742b66ae-15d3-53c2-8735-f791fbea8d81",
      "metadata": {
        "author": "Wazuh, Inc.",
        "date": "2026-06-17",
        "description": "Parent decoder for container application logs collected from Docker JSON log files. Unwraps the Docker log envelope and overwrites event.original with the extracted application log so that existing downstream decoders can match without modification.",
        "documentation": "https://documentation.wazuh.com/current/user-manual/capabilities/container-security/index.html",
        "modified": "2026-06-17",
        "references": [
          "https://docs.docker.com/config/containers/logging/json-file/"
        ],
        "supports": [],
        "title": "Docker Container Logs Decoder"
      },
      "name": "decoder/docker-container-logs/0",
      "normalize": [
        {
          "map": [
            {
              "event.kind": "event"
            },
            {
              "container.runtime": "docker"
            },
            {
              "log.logger": "$_tmp_json.stream"
            },
            {
              "event.start": "parse_date($_tmp_json.time, \"%Y-%m-%dT%H:%M:%E*SZ\")"
            },
            {
              "event.original": "$_tmp_json.log"
            }
          ]
        },
        {
          "map": [
            {
              "event.original": "trim(end, \"\\n\")"
            },
            {
              "_tmp_json": "parse_json($event.original)"
            }
          ]
        }
      ],
      "parents": [
        "decoder/core-wazuh-message/0"
      ]
    },
    "type": "decoder"
  },
  "version": 1
}
