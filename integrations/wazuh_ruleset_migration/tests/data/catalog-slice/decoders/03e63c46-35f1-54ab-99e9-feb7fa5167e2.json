  "inserted_at": "2026-09-09T12:08:12.975544Z",
  "name": "03e63c46-35f1-54ab-99e9-feb7fa5167e2",
  "offset": 1387,
  "payload": {
    "document": {
      "enabled": true,
      "id": "03e63c46-35f1-54ab-99e9-feb7fa5167e2",
      "metadata": {
        "author": "Wazuh, Inc.",
        "date": "2025-09-30",
        "description": "Syslog header",
        "documentation": "",
        "modified": "2026-09-02",
        "references": [
          "https://www.ietf.org/rfc/rfc3164.txt",
          "https://www.ietf.org/rfc/rfc5424.txt"
        ],
        "supports": [],
        "title": "Syslog Decoder event"
      },
      "name": "decoder/syslog/0",
      "normalize": [
        {
          "map": [
            {
              "event.kind": "event"
            }
          ]
        },
        {
          "check": [
            {
              "_tmp.hostname": "exists()"
            }
          ],
          "map": [
            {
              "host.hostname": "$_tmp.hostname"
            },
            {
              "related.hosts": "array_append($host.hostname)"
            }
          ]
        },
        {
          "check": [
            {
              "_tmp.syslog.priority": "exists()"
            }
          ],
          "map": [
            {
              "log.syslog.priority": "parse_long($_tmp.syslog.priority)"
            }
          ]
        },
        {
          "check": [
            {
              "log.syslog.priority": "exists()"
            }
          ],
          "map": [
            {
              "log.syslog.facility.code": "int_calculate(div, $log.syslog.priority, 8)"
            },
            {
              "_tmp.facility_base": "int_calculate(mul, $log.syslog.facility.code, 8)"
            },
            {
              "log.syslog.severity.code": "int_calculate(sub, $log.syslog.priority, $_tmp.facility_base)"
            }
          ]
        },
        {
          "check": [
            {
              "log.syslog.facility.code": "exists()"
            }
          ],
          "map": [
            {
              "_tmp.facility_code_str": "to_string($log.syslog.facility.code)"
            },
            {
              "_tmp.severity_code_str": "to_string($log.syslog.severity.code)"
            },
            {
              "log.syslog.facility.name": "kvdb_get(syslog_facility_code_to_name, $_tmp.facility_code_str)"
            },
            {
              "log.syslog.severity.name": "kvdb_get(syslog_severity_code_to_name, $_tmp.severity_code_str)"
            }
          ]
        },
        {
          "check": [
            {
              "_tmp.syslog.version": "exists()"
            }
          ],
          "map": [
            {
              "log.syslog.version": "$_tmp.syslog.version"
            }
          ]
        },
        {
          "check": [
            {
              "_TAG": "exists()"
            }
          ],
          "map": [
            {
              "process.name": "rename($_TAG)"
            }
          ]
        },
        {
          "check": [
            {
              "_tmp.syslog.msgid": "exists()"
            }
          ],
          "map": [
            {
              "log.syslog.msgid": "$_tmp.syslog.msgid"
            }
          ]
        },
        {
          "check": [
            {
              "_tmp.syslog.structured_data": "exists()"
            }
          ],
          "map": [
            {
              "_tmp.sd_kv": "regex_extract($_tmp.syslog.structured_data, '^\\\\S+\\\\s+(.*)$')"
            }
          ]
        },
        {
          "check": [
            {
              "_tmp.sd_kv": "exists()"
            }
          ],
          "map": [
            {
              "_tmp.sd_parsed": "parse_key_value($_tmp.sd_kv, '=', ' ', '\"', '\\\\')"
            },
            {
              "log.syslog.structured_data": "$_tmp.sd_parsed"
            }
          ]
        },
        {
          "check": [
            {
              "_tmp.host_ip": "exists()"
            }
          ],
          "map": [
            {
              "host.ip": "array_append($_tmp.host_ip)"
            }
          ]
        },
        {
          "check": [
            {
              "_tmp": "exists()"
            }
          ],
          "map": [
            {
              "_tmp": "delete()"
            }
          ]
        }
      ],
      "parents": [
        "decoder/core-wazuh-message/0"
      ],
      "parse|event.original": [
        "<event.start/Jun 14 15:16:01> <_tmp.hostname/alphanumeric/-._:[]> <_TAG/alphanumeric/-._>[<process.pid>] \\(<log.logger>\\):<~/ignore/ ><message>",
        "<event.start/Jun 14 15:16:01> <_tmp.hostname/alphanumeric/-._:[]> <_TAG>[<process.pid>]:<~/ignore/ ><message>",
        "<event.start/Jun 14 15:16:01> <_tmp.hostname/alphanumeric/-._:[]> <_TAG>:<~/ignore/ ><message>",
        "<event.start/2018-08-14T14:30:02.203151+02:00> <_tmp.hostname/alphanumeric/-._:[]> <_TAG>[<process.pid>]: <message>",
        "<event.start/2018-08-14T14:30:02.203151+02:00> <_tmp.hostname/alphanumeric/-._:[]> <_TAG>: <message>",
        "<event.start/ISO8601Z> <_tmp.hostname/alphanumeric/-._:[]> <_TAG>: <message>",
        "<event.start/SYSLOG> <_tmp.hostname/alphanumeric/-._:[]><?~/ignore/ >(?: )<message>",
        "<event.start/%Y %b %d %T> <_timezone> <_tmp.hostname/alphanumeric/-._:[]> <_tmp.host_ip> <_TAG>[<process.pid>]:<~/ignore/ ><message>",
        "<event.start/%Y %b %d %T> <_tmp.hostname/alphanumeric/-._:[]> <_tmp.host_ip> <_TAG>[<process.pid>]:<~/ignore/ ><message>",
        "<?_tmp.syslog.priority/between/</\\>><event.start/%b %d %T>?<event.start/%b %d %Y %T>(? <_tmp.hostname/alphanumeric/.-_:[]>)<?~/ignore/ ><?_TAG/alphanumeric/-._>(?[<process.pid>])<?~/ignore/ >: <message>",
        "<?_tmp.syslog.priority/between/</\\>><event.start/ISO8601Z>(? <_tmp.hostname/alphanumeric/.-_:[]>)<?~/ignore/ ><?_TAG/alphanumeric/-._>(?[<process.pid>])<?~/ignore/ >: <message>",
        "\\<<log.syslog.priority>><event.start/SYSLOG> <_tmp.hostname/alphanumeric/-._:[]> <_TAG/alphanumeric/-._>(?[<process.pid>]): <message>",
        "\\<<log.syslog.priority>><event.start/ISO8601Z> <_tmp.hostname/alphanumeric/-._:[]> <_TAG/alphanumeric/-._>(?[<process.pid>]): <message>",
        "\\<<log.syslog.priority>><_tmp.syslog.version> <event.start/ISO8601Z> <_tmp.hostname/alphanumeric/-._:[]> <_TAG> <process.pid> <_tmp.syslog.msgid/alphanumeric/-> -<~/ignore/ ><message>",
        "\\<<log.syslog.priority>><_tmp.syslog.version> <event.start/ISO8601Z> <_tmp.hostname/alphanumeric/-._:[]> <_TAG> <process.pid> <_tmp.syslog.msgid/alphanumeric/-> <_tmp.syslog.structured_data/between/[/]> <message>"
      ]
    },
    "type": "decoder"
  },
  "version": 2
}
