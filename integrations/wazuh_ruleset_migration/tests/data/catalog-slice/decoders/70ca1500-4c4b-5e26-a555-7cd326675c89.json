{
  "inserted_at": "2026-09-09T12:08:12.046416Z",
  "name": "70ca1500-4c4b-5e26-a555-7cd326675c89",
  "offset": 1743,
  "payload": {
    "document": {
      "check": "$isAuthEvent",
      "definitions": {
        "isAuthEvent": "$process.name == sshd OR $process.name == sudo OR $process.name == groupadd OR $process.name == useradd OR $process.name == groupdel OR $process.name == groupmod OR $process.name == userdel OR $process.name == usermod OR $process.name == CRON OR $process.name == sshd-session OR $process.name == sshd-auth OR $process.name == su OR $process.name == passwd OR $process.name == chfn OR $process.name == chage OR $process.name == crontab OR $process.name == gpasswd OR $process.name == chsh OR $process.name == newgrp OR $process.name == polkitd OR $process.name == systemd-logind OR $process.name == sssd OR starts_with($message, 'pam_unix(') OR starts_with($message, 'pam_faillock(') OR starts_with($message, 'pam_sss(')"
      },
      "enabled": true,
      "id": "70ca1500-4c4b-5e26-a555-7cd326675c89",
      "metadata": {
        "author": "Wazuh, Inc.",
        "date": "2023-05-15",
        "description": "Decoder for system athenticated action logs.",
        "documentation": "",
        "modified": "2026-09-28",
        "references": [
          "https://www.loggly.com/ultimate-guide/linux-logging-basics/"
        ],
        "supports": [],
        "title": "system-auth logs"
      },
      "name": "decoder/system-auth/0",
      "normalize": [
        {
          "map": [
            {
              "event.dataset": "system-auth"
            },
            {
              "event.kind": "event"
            }
          ]
        },
        {
          "check": "$process.name == sshd OR $process.name == sshd-session OR $process.name == sshd-auth",
          "parse|message": [
            "error: maximum authentication attempts <_system.auth.ssh.event> for (?invalid user )<user.name> from <source.ip> port <source.port> ssh2 <~>",
            "<_system.auth.ssh.event> <_system.auth.ssh.method> for (?invalid user )<user.name> from <source.ip> port <source.port> ssh2<?_system.auth.ssh.trailer>",
            "<_system.auth.ssh.event> user <user.name> from <source.ip>(? port <source.port>)",
            "Did not receive identification string from <source.ip>",
            "subsystem request for <_system.auth.ssh.subsystem> by user <user.name>",
            "<_system.auth.ssh.session.action>: Too many authentication <_system.auth.ssh.event> for <user.name> [preauth]",
            "<user.name> [<~>][<~>]: <_system.auth.ssh.event>: <_system.auth.ssh.session.process_id> tty<~/literal/\\/>?<~/literal/s><_system.process.tty.char_device.major>",
            "<_system.auth.ssh.event>: Read from socket failed: Connection reset by peer [preauth]",
            "Received <_system.auth.ssh.event> from <source.ip>: <~>:  [<~>]",
            "Received <_system.auth.ssh.event> from <source.ip> port <source.port>:<~>",
            "<_system.auth.ssh.event> invalid user <user.name> <source.ip> port <source.port>: Too many authentication failures<~>",
            "<_system.auth.ssh.event> authenticating user <user.name> <source.ip> port <source.port>: Too many authentication failures<~>",
            "Connection <_system.auth.ssh.event> by invalid user <user.name> <source.ip> port <source.port> <~>",
            "Connection <_system.auth.ssh.event> by authenticating user <user.name> <source.ip> port <source.port><~>"
          ]
        },
        {
          "check": "$_system.auth.ssh.event == Accepted OR $_system.auth.ssh.event == USER_PROCESS",
          "map": [
            {
              "event.action": "logged-in"
            },
            {
              "event.category": "array_append(authentication, session)"
            },
            {
              "event.outcome": "success"
            },
            {
              "event.type": "array_append(info)"
            }
          ]
        },
        {
          "check": "$_system.auth.ssh.event == DEAD_PROCESS",
          "map": [
            {
              "event.action": "logged-out"
            },
            {
              "event.category": "array_append(authentication, session)"
            },
            {
              "event.outcome": "success"
            },
            {
              "event.type": "array_append(end)"
            }
          ]
        },
        {
          "check": "$_system.auth.ssh.event == disconnect",
          "map": [
            {
              "event.action": "connection-closed"
            },
            {
              "event.category": "array_append(authentication, session)"
            },
            {
              "event.outcome": "success"
            },
            {
              "event.type": "array_append(end)"
            }
          ]
        },
        {
          "check": "$_system.auth.ssh.event == Invalid OR $_system.auth.ssh.event == Failed OR $_system.auth.ssh.event == failures OR $_system.auth.ssh.event == fatal OR $_system.auth.ssh.event == exceeded OR $_system.auth.ssh.event == Disconnecting",
          "map": [
            {
              "event.action": "authentication-failure"
            },
            {
              "event.category": "array_append(authentication)"
            },
            {
              "event.outcome": "failure"
            },
            {
              "event.type": "array_append(info)"
            }
          ]
        },
        {
          "check": "$_system.auth.ssh.event == closed OR $_system.auth.ssh.event == reset",
          "map": [
            {
              "event.action": "connection-closed"
            },
            {
              "event.category": "array_append(authentication)"
            },
            {
              "event.outcome": "failure"
            },
            {
              "event.type": "array_append(info)"
            }
          ]
        },
        {
          "check": "exists($_system.auth.ssh.method)",
          "map": [
            {
              "event.reason": "concat($_system.auth.ssh.event, ' ', $_system.auth.ssh.method)"
            }
          ]
        },
        {
          "check": "exists($_system.auth.ssh.trailer)",
          "parse|_system.auth.ssh.trailer": [
            ": <_system.auth.ssh.key_algo> <_system.auth.ssh.key_fingerprint>"
          ]
        },
        {
          "check": "exists($_system.auth.ssh.key_fingerprint)",
          "map": [
            {
              "related.hash": "array_append_unique($_system.auth.ssh.key_fingerprint)"
            }
          ]
        },
        {
          "check": "exists($_system.auth.ssh.subsystem)",
          "map": [
            {
              "event.action": "session-started"
            },
            {
              "event.category": "array_append(authentication, session)"
            },
            {
              "event.outcome": "success"
            },
            {
              "event.type": "array_append(start)"
            }
          ]
        },
        {
          "check": [
            {
              "message": "contains(\"ROOT LOGIN REFUSED FROM\")"
            }
          ],
          "map": [
            {
              "user.name": "root"
            },
            {
              "event.action": "authentication-failure"
            },
            {
              "event.category": "array_append(authentication)"
            },
            {
              "event.outcome": "failure"
            },
            {
              "event.type": "array_append(info)"
            }
          ],
          "parse|message": [
            "ROOT LOGIN REFUSED FROM <source.ip> port <source.port>"
          ]
        },
        {
          "check": [
            {
              "message": "contains(\"Authentication refused: bad ownership or modes\")"
            }
          ],
          "map": [
            {
              "event.action": "authentication-failure"
            },
            {
              "event.category": "array_append(authentication)"
            },
            {
              "event.outcome": "failure"
            },
            {
              "event.type": "array_append(info)"
            }
          ],
          "parse|message": [
            "Authentication refused: bad ownership or modes for directory <_system.auth.badmode.dir>"
          ]
        },
        {
          "check": [
            {
              "message": "contains(\"Unable to negotiate with\")"
            }
          ],
          "map": [
            {
              "event.action": "connection-denied"
            },
            {
              "event.category": "array_append(authentication, network)"
            },
            {
              "event.outcome": "failure"
            },
            {
              "event.type": "array_append(denied)"
            }
          ],
          "parse|message": [
            "Unable to negotiate with <source.ip> port <source.port>: <~>"
          ]
        },
        {
          "check": [
            {
              "message": "contains(\"kex_exchange_identification\")"
            }
          ],
          "map": [
            {
              "event.action": "connection-closed"
            },
            {
              "event.category": "array_append(authentication, network)"
            },
            {
              "event.outcome": "failure"
            },
            {
              "event.type": "array_append(end)"
            }
          ],
          "parse|message": [
            "error: kex_exchange_identification: Connection closed by remote host"
          ]
        },
        {
          "check": [
            {
              "message": "contains(\"past MaxStartups\")"
            }
          ],
          "map": [
            {
              "event.action": "connection-denied"
            },
            {
              "event.category": "array_append(authentication, network)"
            },
            {
              "event.outcome": "failure"
            },
            {
              "event.type": "array_append(denied)"
            }
          ],
          "parse|message": [
            "drop connection #<_system.auth.ssh.maxstartups.count> from [<source.ip>]:<source.port> on [<destination.ip>]:<destination.port> past MaxStartups"
          ]
        },
        {
          "check": [
            {
              "message": "contains(\"Server listening on\")"
            }
          ],
          "map": [
            {
              "source.port": "parse_long($_tmp.listen_port)"
            },
            {
              "event.action": "service-started"
            },
            {
              "event.category": "array_append(host)"
            },
            {
              "event.outcome": "success"
            },
            {
              "event.type": "array_append(start)"
            }
          ],
          "parse|message": [
            "Server listening on <source.ip> port <_tmp.listen_port>."
          ]
        },
        {
          "check": [
            {
              "process.name": "sudo"
            }
          ],
          "map": [
            {
              "event.action": "sudo"
            },
            {
              "event.category": "array_append(authentication, process)"
            }
          ],
          "parse|message": [
            "<?~/ignore/ ><user.name> : TTY=<_system.auth.sudo.tty> ; PWD=<_system.auth.sudo.pwd> ; USER=<user.effective.name> ; ENV=<_system.auth.sudo.env> ; COMMAND=<_system.auth.sudo.command>",
            "<?~/ignore/ ><user.name> : TTY=tty<~/literal/\\/>?<~/literal/s><_system.process.tty.char_device.major> ; PWD=<_system.auth.sudo.pwd> ; USER=<user.effective.name> ; ENV=<_system.auth.sudo.env> ; COMMAND=<_system.auth.sudo.command>",
            "<?~/ignore/ ><user.name> : TTY=<_system.auth.sudo.tty> ; PWD=<_system.auth.sudo.pwd> ; USER=<user.effective.name> ; COMMAND=<_system.auth.sudo.command>",
            "<?~/ignore/ ><user.name> : TTY=tty<~/literal/\\/>?<~/literal/s><_system.process.tty.char_device.major> ; PWD=<_system.auth.sudo.pwd> ; USER=<user.effective.name> ; COMMAND=<_system.auth.sudo.command>",
            "<?~/ignore/ ><user.name> : PWD=<_system.auth.sudo.pwd> ; USER=<user.effective.name> ; ENV=<_system.auth.sudo.env> ; COMMAND=<_system.auth.sudo.command>",
            "<?~/ignore/ ><user.name> : PWD=<_system.auth.sudo.pwd> ; USER=<user.effective.name> ; COMMAND=<_system.auth.sudo.command>",
            "<?~/ignore/ ><user.name> : <_system.auth.sudo.error> ; TTY=tty<~/literal/\\/>?<~/literal/s><_system.process.tty.char_device.major> ; PWD=<_system.auth.sudo.pwd> ; USER=<user.effective.name> ; COMMAND=<_system.auth.sudo.command>",
            "<?~/ignore/ ><user.name> : <_system.auth.sudo.error> ; TTY=<_system.auth.sudo.tty> ; PWD=<_system.auth.sudo.pwd> ; USER=<user.effective.name> ; COMMAND=<_system.auth.sudo.command>",
            "<?~/ignore/ ><user.name> : <_system.auth.sudo.error> ; PWD=<_system.auth.sudo.pwd> ; USER=<user.effective.name> ; COMMAND=<_system.auth.sudo.command>"
          ]
        },
        {
          "check": "$process.name == sudo AND $event.action == sudo AND exists($_system.auth.sudo.error)",
          "map": [
            {
              "event.action": "authentication-failure"
            },
            {
              "event.outcome": "failure"
            },
            {
              "event.type": "array_append(denied)"
            }
          ]
        },
        {
          "check": "$process.name == sudo AND $event.action == sudo AND not_exists($_system.auth.sudo.error)",
          "map": [
            {
              "event.outcome": "success"
            },
            {
              "event.type": "array_append(start)"
            }
          ]
        },
        {
          "check": [
            {
              "message": "contains(\"session opened\")"
            }
          ],
          "map": [
            {
              "event.action": "logged-in"
            },
            {
              "event.type": "array_append(start)"
            }
          ]
        },
        {
          "check": [
            {
              "message": "contains(\"session closed\")"
            }
          ],
          "map": [
            {
              "event.action": "logged-out"
            },
            {
              "event.type": "array_append(end)"
            }
          ]
        },
        {
          "check": [
            {
              "message": "contains(\"Disconnected from user\")"
            }
          ],
          "map": [
            {
              "event.action": "connection-closed"
            },
            {
              "event.category": "array_append(authentication, session)"
            },
            {
              "event.outcome": "success"
            },
            {
              "event.type": "array_append(end)"
            }
          ],
          "parse|message": [
            "Disconnected from user <user.name> <source.ip> port <source.port>"
          ]
        },
        {
          "check": [
            {
              "message": "contains(\"Change of username or service not allowed\")"
            }
          ],
          "map": [
            {
              "event.action": "authentication-failure"
            },
            {
              "event.category": "array_append(authentication)"
            },
            {
              "event.outcome": "failure"
            },
            {
              "event.type": "array_append(info)"
            },
            {
              "related.user": "array_append_unique($user.target.name)"
            }
          ],
          "parse|message": [
            "Disconnecting: Change of username or service not allowed: \\(<user.name>,<~>\\) -> \\(<user.target.name>,<~>\\) <~>"
          ]
        },
        {
          "check": [
            {
              "message": "contains(pam_faillock)"
            }
          ],
          "map": [
            {
              "event.action": "user-locked"
            },
            {
              "event.category": "array_append(authentication, iam)"
            },
            {
              "event.type": "array_append(denied)"
            },
            {
              "event.outcome": "failure"
            },
            {
              "related.user": "array_append_unique($user.name)"
            }
          ],
          "parse|message": [
            "pam_faillock\\(<~>:<~>\\): Consecutive login failures for user <user.name> account temporarily locked"
          ]
        },
        {
          "check": [
            {
              "message": "contains(pam_)"
            }
          ],
          "map": [
            {
              "event.category": "array_append(authentication)"
            },
            {
              "event.type": "array_append(info)"
            }
          ],
          "parse|message": [
            "pam_unix\\(<~>:<~>\\): authentication <_system.auth.pam.session.action>; logname=<?_system.auth.pam.foruser.name> uid=<?user.id> euid=<?user.effective.id> tty=<?_system.auth.pam.tty> ruser=<?_system.auth.pam.remote.user> rhost=<?source.ip><~>user=<?user.name>",
            "pam_sss\\(<~>:<~>\\): authentication <_system.auth.pam.session.action>; logname=<?_system.auth.pam.foruser.name> uid=<?user.id> euid=<?user.effective.id> tty=<?_system.auth.pam.tty> ruser=<?_system.auth.pam.remote.user> rhost=<?source.ip><~>user=<?user.name>"
          ]
        },
        {
          "check": [
            {
              "message": "contains(pam_)"
            }
          ],
          "map": [
            {
              "event.category": "array_append(session)"
            }
          ],
          "parse|message": [
            "pam_unix\\(<~>:<~>\\): session <_system.auth.pam.session.action> for user <_system.auth.pam.foruser.name>\\(uid=<user.effective.id>\\) by <_system.auth.pam.byuser.name>\\(uid=<user.id>\\)",
            "pam_unix\\(<~>:<~>\\): session <_system.auth.pam.session.action> for user <_system.auth.pam.foruser.name> by <_system.auth.pam.byuser.name>\\(uid=<user.id>\\)",
            "pam_unix\\(<~>:<~>\\): session <_system.auth.pam.session.action> for user <_system.auth.pam.foruser.name>\\(uid=<user.effective.id>\\) by \\(uid=<user.id>\\)",
            "pam_unix\\(<~>:<~>\\): session <_system.auth.pam.session.action> for user <_system.auth.pam.foruser.name> by \\(uid=<user.id>\\)",
            "pam_unix\\(<~>:<~>\\): session <_system.auth.pam.session.action> for user <_system.auth.pam.foruser.name>"
          ]
        },
        {
          "check": "$_system.auth.pam.session.action == closed AND ($process.name == sshd OR $process.name == sshd-session OR $process.name == sshd-auth OR $process.name == login)",
          "map": [
            {
              "event.category": "array_append(authentication)"
            }
          ]
        },
        {
          "check": "$_system.auth.pam.session.action == opened AND $process.name == login",
          "map": [
            {
              "event.category": "array_append(authentication)"
            }
          ]
        },
        {
          "check": [
            {
              "message": "contains(pam_succeed_if)"
            }
          ],
          "map": [
            {
              "event.outcome": "failure"
            }
          ],
          "parse|message": [
            "pam_succeed_if\\(<~>:<~>\\): requirement <~> not met by user \"<user.name>\""
          ]
        },
        {
          "check": "$process.name == passwd",
          "map": [
            {
              "event.action": "password-changed"
            },
            {
              "event.category": "array_append(iam)"
            },
            {
              "event.type": "array_append(change)"
            },
            {
              "event.outcome": "success"
            }
          ],
          "parse|message": [
            "pam_unix\\(<~>:chauthtok\\): password changed for <user.name>"
          ]
        },
        {
          "check": [
            {
              "message": "contains(PAM)"
            }
          ],
          "map": [
            {
              "event.category": "array_append(authentication, session)"
            },
            {
              "event.type": "array_append(info)"
            }
          ],
          "parse|message": [
            "PAM <~> more authentication <_system.auth.pam.session.action>; logname=<?_system.auth.pam.foruser.name> uid=<?user.id> euid=<?user.effective.id> tty=<?_system.auth.pam.tty> ruser=<?_system.auth.pam.remote.user> rhost=<?source.ip><~>user=<?user.name>"
          ]
        },
        {
          "check": [
            {
              "message": "contains(PAM)"
            }
          ],
          "parse|message": [
            "error: PAM: <~> authentication <~> user <user.name> from <source.address>"
          ]
        },
        {
          "check": [
            {
              "_system.auth.pam.byuser.name": "string_not_equal('')"
            }
          ],
          "map": [
            {
              "user.name": "$_system.auth.pam.byuser.name"
            },
            {
              "user.effective.name": "$_system.auth.pam.foruser.name"
            }
          ]
        },
        {
          "check": "$process.name == login AND $_system.auth.pam.byuser.name == LOGIN",
          "map": [
            {
              "user.name": "$_system.auth.pam.foruser.name"
            },
            {
              "user.effective.name": "delete()"
            }
          ]
        },
        {
          "check": "not_exists($_system.auth.pam.byuser.name) AND $_system.auth.pam.session.action == closed",
          "map": [
            {
              "user.name": "$_system.auth.pam.foruser.name"
            },
            {
              "user.effective.name": "$_system.auth.pam.foruser.name"
            }
          ]
        },
        {
          "check": "not_exists($_system.auth.pam.byuser.name) AND NOT $_system.auth.pam.session.action == closed",
          "map": [
            {
              "user.name": "$_system.auth.pam.foruser.name"
            }
          ]
        },
        {
          "check": "$process.name == groupadd OR $process.name == useradd",
          "parse|message": [
            "new group: name=<group.name>, GID=<group.id>",
            "new user: name=<user.name>, UID=<user.id>, GID=<group.id>, home=<_system.auth.useradd.home>, shell=<_system.auth.useradd.shell>(?,<~>)",
            "group added to <file.name>: name=<group.name>(?, GID=<group.id>)",
            "<_system.auth.event.outcome> adding user '<user.name>'(?,<~>)"
          ]
        },
        {
          "check": "$process.name == userdel OR $process.name == usermod",
          "parse|message": [
            "<~> user '<user.name>'",
            "<~> user '<user.name>'<~>"
          ]
        },
        {
          "check": "$process.name == chfn",
          "map": [
            {
              "event.action": "user-modified"
            },
            {
              "event.category": "array_append(iam)"
            },
            {
              "event.type": "array_append(change)"
            },
            {
              "event.outcome": "success"
            }
          ],
          "parse|message": [
            "changed user '<user.name>' information"
          ]
        },
        {
          "check": "$process.name == chage",
          "map": [
            {
              "event.action": "config-modified"
            },
            {
              "event.category": "array_append(iam)"
            },
            {
              "event.type": "array_append(change)"
            },
            {
              "event.outcome": "success"
            }
          ],
          "parse|message": [
            "changed password expiry for <user.name>"
          ]
        },
        {
          "check": "$process.name == gpasswd",
          "map": [
            {
              "event.category": "array_append(iam)"
            },
            {
              "event.type": "array_append(group, change)"
            },
            {
              "event.outcome": "success"
            },
            {
              "related.user": "array_append_unique($user.target.name)"
            }
          ],
          "parse|message": [
            "user <user.target.name> <_system.auth.gpasswd.action> by <user.name> to group <group.name>",
            "user <user.target.name> <_system.auth.gpasswd.action> by <user.name> from group <group.name>"
          ]
        },
        {
          "check": "$_system.auth.gpasswd.action == added",
          "map": [
            {
              "event.action": "user-added-to-group"
            }
          ]
        },
        {
          "check": "$_system.auth.gpasswd.action == removed",
          "map": [
            {
              "event.action": "user-removed-from-group"
            }
          ]
        },
        {
          "check": "$process.name == chsh",
          "map": [
            {
              "event.action": "user-modified"
            },
            {
              "event.category": "array_append(iam)"
            },
            {
              "event.type": "array_append(change)"
            },
            {
              "event.outcome": "success"
            }
          ],
          "parse|message": [
            "changed user \"<user.name>\" shell to \"<_system.auth.chsh.shell>\""
          ]
        },
        {
          "check": "$process.name == newgrp",
          "map": [
            {
              "event.action": "group-changed"
            },
            {
              "event.category": "array_append(iam, session)"
            },
            {
              "event.type": "array_append(change)"
            },
            {
              "event.outcome": "success"
            }
          ],
          "parse|message": [
            "user <user.name> switched to group <group.name>"
          ]
        },
        {
          "check": "$process.name == polkitd",
          "map": [
            {
              "event.action": "service-registered"
            },
            {
              "event.category": "array_append(iam)"
            },
            {
              "event.type": "array_append(info)"
            },
            {
              "event.outcome": "success"
            }
          ],
          "parse|message": [
            "Registered Authentication Agent for <_system.auth.polkit.subject/alphanumeric/-.:_><~>"
          ]
        },
        {
          "check": "$process.name == CRON",
          "map": [
            {
              "event.category": "array_append(process)"
            }
          ],
          "parse|message": [
            "\\(<user.name>\\) CMD \\(<process.command_line>\\)"
          ]
        },
        {
          "check": "$process.name == systemd-logind",
          "map": [
            {
              "event.category": "array_append(session)"
            }
          ],
          "parse|message": [
            "New session <_system.auth.logind.session_id> of user <user.name>.",
            "Removed session <_system.auth.logind.session_id>."
          ]
        },
        {
          "check": [
            {
              "process.name": "sssd"
            },
            {
              "message": "contains(\"Backend is offline\")"
            }
          ],
          "map": [
            {
              "event.category": "array_append(authentication)"
            },
            {
              "event.outcome": "failure"
            },
            {
              "event.type": "array_append(info)"
            }
          ]
        },
        {
          "check": [
            {
              "process.name": "sssd"
            },
            {
              "message": "contains(\"Backend is online\")"
            }
          ],
          "map": [
            {
              "event.category": "array_append(authentication)"
            },
            {
              "event.outcome": "success"
            },
            {
              "event.type": "array_append(info)"
            }
          ]
        },
        {
          "check": "$process.name == crontab",
          "parse|message": [
            "\\(<user.name>\\) <_system.auth.crontab.action> \\(<~>\\)"
          ]
        },
        {
          "check": "$_system.auth.crontab.action == REPLACE",
          "map": [
            {
              "event.action": "scheduled-task-modified"
            },
            {
              "event.category": "array_append(host)"
            },
            {
              "event.type": "array_append(change)"
            }
          ]
        },
        {
          "check": "$_system.auth.crontab.action == DELETE",
          "map": [
            {
              "event.action": "scheduled-task-deleted"
            },
            {
              "event.category": "array_append(host)"
            },
            {
              "event.type": "array_append(deletion)"
            }
          ]
        },
        {
          "check": "$_system.auth.crontab.action == LIST",
          "map": [
            {
              "event.category": "array_append(host)"
            },
            {
              "event.type": "array_append(access)"
            }
          ]
        },
        {
          "check": "$process.name == su",
          "map": [
            {
              "event.action": "logged-in"
            },
            {
              "event.category": "array_append(authentication, session)"
            },
            {
              "event.type": "array_append(start)"
            },
            {
              "event.outcome": "success"
            },
            {
              "related.user": "array_append_unique($user.target.name)"
            }
          ],
          "parse|message": [
            "Successful su for <user.target.name> by <user.name>",
            "+ <~> <user.name>:<user.target.name>"
          ]
        },
        {
          "check": "$_system.auth.event.outcome == failed OR $_system.auth.pam.session.action == failure OR $_system.auth.pam.session.action == failures",
          "map": [
            {
              "event.outcome": "failure"
            }
          ]
        },
        {
          "check": "$process.name == groupadd OR $process.name == groupdel OR $process.name == groupmod OR $process.name == useradd OR $process.name == userdel OR $process.name == usermod",
          "map": [
            {
              "event.category": "array_append(iam)"
            }
          ]
        },
        {
          "check": "$process.name == useradd OR $process.name == userdel OR $process.name == usermod",
          "map": [
            {
              "event.type": "array_append(user)"
            }
          ]
        },
        {
          "check": "$process.name == groupadd OR $process.name == groupdel OR $process.name == groupmod",
          "map": [
            {
              "event.type": "array_append(group)"
            }
          ]
        },
        {
          "check": "$process.name == groupadd OR $process.name == useradd",
          "map": [
            {
              "event.type": "array_append(creation)"
            }
          ]
        },
        {
          "check": "$process.name == groupdel OR $process.name == userdel",
          "map": [
            {
              "event.type": "array_append(deletion)"
            }
          ]
        },
        {
          "check": "$process.name == groupmod OR $process.name == usermod",
          "map": [
            {
              "event.type": "array_append(change)"
            }
          ]
        },
        {
          "check": "$process.name == useradd",
          "map": [
            {
              "event.action": "user-created"
            }
          ]
        },
        {
          "check": "$process.name == userdel",
          "map": [
            {
              "event.action": "user-deleted"
            }
          ]
        },
        {
          "check": "$process.name == usermod",
          "map": [
            {
              "event.action": "user-modified"
            }
          ]
        },
        {
          "map": [
            {
              "source.address": "$source.ip"
            },
            {
              "related.user": "array_append_any($user.name, $user.effective.name)"
            },
            {
              "related.ip": "array_append($source.ip)"
            },
            {
              "process.command_line": "$_system.auth.sudo.command"
            },
            {
              "process.tty.char_device.major": "parse_long($_system.process.tty.char_device.major)"
            },
            {
              "process.working_directory": "$_system.auth.sudo.pwd"
            }
          ]
        },
        {
          "check": "$process.name == useradd OR $process.name == userdel OR $process.name == usermod",
          "map": [
            {
              "user.target.name": "$user.name"
            },
            {
              "related.user": "array_append_unique($user.target.name)"
            }
          ]
        },
        {
          "check": "exists($source.address) AND NOT is_ipv4($source.address) AND NOT is_ipv6($source.address) AND contains($source.address, \".\")",
          "map": [
            {
              "source.domain": "parse_fqdn($source.address)"
            }
          ]
        },
        {
          "check": "exists($event.category) AND not_exists($event.outcome)",
          "map": [
            {
              "event.outcome": "success"
            }
          ]
        },
        {
          "check": "not_exists($event.category) AND ($process.name == sshd OR $process.name == sshd-session OR $process.name == sshd-auth) AND exists($_system.auth.ssh.event)",
          "map": [
            {
              "event.category": "array_append(authentication)"
            }
          ]
        },
        {
          "check": [
            {
              "message": "contains(\"authentication failure; logname=\")"
            }
          ],
          "map": [
            {
              "_tmp.pam_rhost": "regex_extract($message, 'rhost=([^ ]+)')"
            },
            {
              "event.category": "array_append_unique(authentication)"
            },
            {
              "event.outcome": "failure"
            }
          ]
        },
        {
          "check": "exists($_tmp.pam_rhost) AND NOT regex_match($_tmp.pam_rhost, '^[0-9A-Fa-f.:]+$')",
          "map": [
            {
              "source.address": "$_tmp.pam_rhost"
            },
            {
              "source.domain": "$_tmp.pam_rhost"
            }
          ]
        },
        {
          "check": "not_exists($event.category) AND $process.name == CRON",
          "map": [
            {
              "event.category": "array_append(host)"
            }
          ]
        },
        {
          "check": "not_exists($event.type)",
          "map": [
            {
              "event.type": "array_append(info)"
            }
          ]
        },
        {
          "check": "not_exists($event.outcome)",
          "map": [
            {
              "event.outcome": "unknown"
            }
          ]
        }
      ],
      "parents": [
        "decoder/syslog/0"
      ]
    },
    "type": "decoder"
  },
  "version": 6
}
