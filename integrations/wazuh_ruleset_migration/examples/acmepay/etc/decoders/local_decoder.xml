<!-- Custom decoders for the "acmepay" payment gateway -->
<decoder name="acmepay">
  <program_name>^acmepay</program_name>
</decoder>

<decoder name="acmepay-login">
  <parent>acmepay</parent>
  <prematch>^login </prematch>
  <regex offset="after_prematch">^(\w+) user=(\S+) src=(\d+.\d+.\d+.\d+) tenant=(\S+)</regex>
  <order>status, user, srcip, acmepay.tenant</order>
</decoder>

<decoder name="acmepay-payment">
  <parent>acmepay</parent>
  <prematch>^payment </prematch>
  <regex offset="after_prematch">^id=(\S+) amount=(\d+) currency=(\w+) merchant=(\S+)</regex>
  <order>id, acmepay.amount, acmepay.currency, acmepay.merchant</order>
</decoder>
