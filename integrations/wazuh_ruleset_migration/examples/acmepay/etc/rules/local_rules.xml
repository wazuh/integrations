<!-- Custom rules for the "acmepay" payment gateway -->
<group name="acmepay,">

  <rule id="100200" level="0">
    <decoded_as>acmepay</decoded_as>
    <description>acmepay: grouping rule.</description>
  </rule>

  <rule id="100201" level="5">
    <if_sid>100200</if_sid>
    <status>^failed$</status>
    <description>acmepay: failed login for user $(user) from $(srcip).</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <rule id="100202" level="0">
    <if_sid>100201</if_sid>
    <user>^healthcheck$</user>
    <description>acmepay: ignore failed logins of the monitoring account.</description>
  </rule>

  <rule id="100203" level="10" frequency="8" timeframe="120">
    <if_matched_sid>100201</if_matched_sid>
    <same_source_ip />
    <description>acmepay: brute force against the payment gateway from $(srcip).</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <rule id="100204" level="12">
    <if_sid>100200</if_sid>
    <field name="acmepay.currency">^XMR$|^BTC$</field>
    <description>acmepay: payment in a non-authorized currency ($(acmepay.currency)) for merchant $(acmepay.merchant).</description>
    <group>pci_dss_10.6.1,</group>
  </rule>

  <rule id="100205" level="10">
    <if_sid>100201</if_sid>
    <list field="srcip" lookup="address_match_key">etc/lists/blocked-ips</list>
    <description>acmepay: failed login from a blocked address ($(srcip)).</description>
  </rule>

  <rule id="100206" level="7">
    <if_sid>100200</if_sid>
    <match>Certificate expired</match>
    <description>acmepay: gateway TLS certificate expired.</description>
  </rule>

</group>

<group name="local,sshd,">

  <!-- Custom rule on top of a stock rule: sshd authentication failure (5716) -->
  <rule id="100300" level="10">
    <if_sid>5716</if_sid>
    <srcip>!10.0.0.0/8</srcip>
    <description>sshd: authentication failed from an address outside the corporate network ($(srcip)).</description>
    <group>authentication_failed,pci_dss_10.2.4,</group>
  </rule>

</group>
